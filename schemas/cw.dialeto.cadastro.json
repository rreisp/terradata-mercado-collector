{
  "formId": "cadastro_participante",
  "title": {
    "pt-BR": "Cadastro de Participante",
    "en-US": "Participant Registration"
  },
  "logo": "EnergyFuels-Logo.png",
  "description": {
    "pt-BR": "Preencha os dados abaixo para se cadastrar no evento.",
    "en-US": "Fill in the information below to register for the event."
  },
  "version": "1.0",
  "method": "POST",
  "url": "https://www.capturewise.terradata.com.br/index.php",
  "modal": {
    "size": "lg",
    "success": {
      "header": {
        "pt-BR": "Sucesso",
        "en-US": "Success"
      },
      "message": {
        "pt-BR": "Os dados foram enviados com sucesso.",
        "en-US": "Data submitted successfully."
      },
      "button": {
        "pt-BR": "Fechar",
        "en-US": "Close"
      }
    },
    "error": {
      "header": {
        "pt-BR": "Aviso",
        "en-US": "Warning"
      },
      "message": {
        "pt-BR": "Houve um problema ao processar sua solicitação. Tente novamente mais tarde.",
        "en-US": "There was a problem processing your request. Please try again later."
      },
      "button": {
        "pt-BR": "Entendi",
        "en-US": "Got it"
      }
    }
  },
  "grid": {
    "columns": 12,
    "gap": "3"
  },
  "rows": [
    {
      "columns": [
        {
          "field": {  
            "id": "photo",
            "label": {
              "pt-BR": "Foto:",
              "en-US": "Photo:"
            },
            "type": "photo",
            "required": true,
            "validations": {
              "min_length": 1,
              "messages": {
                "min_length": {
                  "pt-BR": "Campo obrigatório",
                  "en-US": "Required field"
                }
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },        
        {
          "field": {  
            "id": "nro_filhos",
            "label": {
              "pt-BR": "Número de filhos:",
              "en-US": "Number of children:"
            },
            "type": "number",
            "required": true,
            "validations": {
              "min_length": 1,
              "messages": {
                "min_length": {
                  "pt-BR": "Campo obrigatório",
                  "en-US": "Required field"
                }
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {  
            "id": "height",
            "label": {
              "pt-BR": "Altura:",
              "en-US": "Height:"
            },
            "type": "number",
            "step": 0.01,
            "required": true,
            "validations": {
              "min_length": 1,
              "messages": {
                "min_length": {
                  "pt-BR": "Campo obrigatório",
                  "en-US": "Required field"
                }
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {  
            "id": "participations",
            "label": {
              "pt-BR": "Participações anteriores:",
              "en-US": "Previous participations:"
            },
            "type": "number",
            "max": 10,
            "min": 5,
            "required": true,
            "validations": {
              "min_length": 1,
              "messages": {
                "min_length": {
                  "pt-BR": "Campo obrigatório",
                  "en-US": "Required field"
                }
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },             
        {
          "field": {
            "id": "nome",
            "label": {
              "pt-BR": "Nome completo",
              "en-US": "Full name"
            },
            "type": "text",
            "required": true,
            "placeholder": {
              "pt-BR": "Digite seu nome completo",
              "en-US": "Enter your full name"
            },
            "validations": {
              "min_length": 1,
              "messages": {
                "min_length": {
                  "pt-BR": "Campo obrigatório",
                  "en-US": "Required field"
                }
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "email",
            "label": {
              "pt-BR": "Endereço de e-mail",
              "en-US": "Email address"
            },
            "type": "email",
            "required": true,
            "placeholder": {
              "pt-BR": "exemplo@email.com",
              "en-US": "example@email.com"
            },
            "validations": {
              "min_length": 1,
              "messages": {
                "min_length": {
                  "pt-BR": "Campo obrigatório",
                  "en-US": "Required field"
                }
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "telefone",
            "label": {
              "pt-BR": "Telefone para contato",
              "en-US": "Contact phone"
            },
            "type": "tel",
            "required": false,
            "placeholder": {
              "pt-BR": "(XX) XXXXX-XXXX",
              "en-US": "(XX) XXXXX-XXXX"
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "genero",
            "label": {
              "pt-BR": "Gênero",
              "en-US": "Gender"
            },
            "type": "select",
            "required": false,
            "options": [
              {
                "value": "feminino",
                "label": {
                  "pt-BR": "Feminino",
                  "en-US": "Female"
                }
              },
              {
                "value": "masculino",
                "label": {
                  "pt-BR": "Masculino",
                  "en-US": "Male"
                }
              },
              {
                "value": "outro",
                "label": {
                  "pt-BR": "Outro",
                  "en-US": "Other"
                }
              },
              {
                "value": "prefiro_nao_dizer",
                "label": {
                  "pt-BR": "Prefiro não dizer",
                  "en-US": "Prefer not to say"
                }
              }
            ]
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "data_nascimento",
            "label": {
              "pt-BR": "Data de nascimento",
              "en-US": "Date of birth"
            },
            "type": "date",
            "required": false
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "aceita_termos",
            "label": {
              "pt-BR": "Li e aceito os termos de uso",
              "en-US": "I have read and accept the terms of use"
            },
            "type": "checkbox",
            "required": true,
            "validations": {
              "required": true,
              "messages": {
                "required": {
                  "pt-BR": "Você deve aceitar os termos para continuar",
                  "en-US": "You must accept the terms to proceed"
                }
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
          }
        }
      ]
    }
  ]
}
