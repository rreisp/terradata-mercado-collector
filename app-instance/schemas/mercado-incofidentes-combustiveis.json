{
  "form_id": "mercado-combustiveis",
  "formReturn": "LIST",
  "title": {
    "pt-BR": "⛽ COMBUSTÍVEIS"
  },
  "logo": "MercadoInconfidentes-Logo.png",
  "description": {
    "pt-BR": "Preencha os campos abaixo."
  },
  "version": "1.0",
  "method": "POST",
  "url": "https://www.capturewise.terradata.com.br/index.php",
  "modal": {
    "size": "lg",
    "success": {
      "header": {
        "pt-BR": "Sucesso"
      },
      "message": {
        "pt-BR": "Os dados foram enviados com sucesso."
      },
      "button": {
        "pt-BR": "Fechar"
      }
    },
    "error": {
      "header": {
        "pt-BR": "Aviso",
        "en-US": "Warning"
      },
      "message": {
        "pt-BR": "Houve um problema ao processar sua solicitação. Tente novamente mais tarde."
      },
      "button": {
        "pt-BR": "Entendi"
      }
    }
  },
  "grid": {
    "columns": 12,
    "gap": "3"
  },
  "rows": [
    {
      "columns": [
        {
          "field": {
            "id": "title",
            "label": {
              "pt-BR": "Título da Pesquisa:"
            },
            "type": "sanitized_text",
            "max": 9
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "etanol",
            "type": "number",
            "step":0.01,
            "label": {
              "pt-BR": "Etanol:"
            }            
          },
          "size": {
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
          }
        },
        {
          "field": {
            "id": "gasolina",
            "label": {
              "pt-BR": "Gasolina:"
            },
            "type": "number"
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "gasolina_aditivada",
            "label": {
              "pt-BR": "Gasolina Aditivada:"
            },
            "type": "number"
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "diesel_s10",
            "label": {
              "pt-BR": "Diesel S10:"
            },
            "type": "number"
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "diesel_s500",
            "label": {
              "pt-BR": "Diesel S500:"
            },
            "type": "number"
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "arla",
            "label": {
              "pt-BR": "Arla:"
            },
            "type": "number"
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "data",
            "label": {
              "pt-BR": "Data:"
            },
            "type": "date"
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        }                      
      ]
    }
  ]
}