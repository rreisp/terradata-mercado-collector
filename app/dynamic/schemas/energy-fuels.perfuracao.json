{
  "form_id": "teste_ef_depth_report",
  "title": "RELATÓRIO DE PERFURAÇÃO",
  "logo" : "EnergyFuels-Logo.png",
  "description": "Preencha os campos abaixo.",
  "version": "1.0",
  "method": "POST",
  "url": "https://www.capturewise.terradata.com.br/index.php",
  "modal": {
    "size": "lg",
    "success": {
      "header": "Sucesso",
      "message": "Os dados foram enviados com sucesso.",
      "button": "Fechar"
    },
    "error": {
      "header": "Aviso",
      "message": "Houve um problema ao processar sua solicitação. Tente novamente mais tarde.",
      "button": "Entendi"
    }
  },
  "grid": {
    "columns": 12,
    "gap": "3"
  },
  "rows": [
    {
      "columns": [
        {
          "field": {
            "id": "perfuracao_id",
            "label": "Perfuração ID:",
            "type": "text",
            "required": true,
            "validations": {
              "min_length": 1,
              "messages": {
                "min_length": "Campo obrigatório"
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "ef_coordinates",
            "type": "ef_coordinates"
          },
          "size": {
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
          }
        } ,
        {
          "field": {
            "id": "tenement",
            "label": "Direito Minerário:",
            "type": "text",
            "required": true,
            "validations": {
              "min_length": 1,
              "messages": {
                "min_length": "Campo obrigatório"
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "landowner",
            "label": "Superficiário:",
            "type": "text",
            "required": true,
            "validations": {
              "min_length": 1,
              "messages": {
                "min_length": "Campo obrigatório"
              }
            }
          },
          "size": {
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 4,
            "xl": 4
          }
        },
        {
          "field": {
            "id": "ef_dates",
            "type": "ef_dates"
          },
          "size": {
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
          }
        }
      ]
    },
    {
      "columns": [
        {
          "field": {
            "id": "ef_depth_test",
            "label": "Segmentos:",
            "type": "ef_depth_research"
          },
          "size": {
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
          }
        }
      ]
    }
  ]
}